# Nano CMS frontend .htaccess
#
# Default install path: /blog/. The RewriteBase line below assumes that.
# If installing at a different URL path, update RewriteBase to match.
# This file is a paste-zone file - expect to edit it on first deployment.

Options -Indexes

# Serve the CMS entry point as the directory index, even if a stray
# index.html (host "coming soon" placeholder, or a leftover upload) is
# sitting beside it - otherwise the server shows index.html and the blog
# never loads.
DirectoryIndex index.php index.html

<IfModule mod_headers.c>
    # Defence-in-depth response headers. `always` ensures they're set on
    # error responses too (404 pages etc), where mod_php otherwise can
    # skip the headers table.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /blog/

    # Don't rewrite real files or directories. This lets sitemap.xml,
    # feed.xml, /assets/*.css, /media/*.jpg, and the /admin/ folder be
    # served directly by Apache without going through PHP.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Clean URL routing. URL shape:
    #   /                        blog homepage (category landing)
    #   /<cat>/                  category archive
    #   /<cat>/page/<n>/         paginated category archive
    #   /<cat>/<slug>/           single post
    # More-specific rules first so the post catch-all does not swallow
    # paginated archive URLs.
    RewriteRule ^$ index.php [L]
    RewriteRule ^([a-z0-9-]+)/page/([0-9]+)/?$ index.php?category=$1&page=$2 [QSA,L]
    RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)/?$ post.php?category=$1&slug=$2 [QSA,L]
    RewriteRule ^([a-z0-9-]+)/?$ index.php?category=$1 [QSA,L]
</IfModule>
