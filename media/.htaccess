# Nano CMS media .htaccess
#
# Defence in depth: even though uploads are extension-whitelisted,
# finfo-validated, and re-encoded through GD/Imagick before being
# written, this directory must never execute PHP. If a malicious
# file ever reached disk, the server still must not run it.

php_flag engine off

<FilesMatch "\.(php|phtml|phar)$">
    # Apache 2.2 (most shared hosts still ship the compat module too)
    Order allow,deny
    Deny from all
    # Apache 2.4
    Require all denied
</FilesMatch>

Options -Indexes
