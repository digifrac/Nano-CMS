# =============================================================================
# Nano CMS - .gitignore
# =============================================================================
# This repo holds the CMS source code (frontend + admin codebases).
# It does NOT hold per-deployment content, config, or generated files.
# =============================================================================


# -----------------------------------------------------------------------------
# Local-only tooling state - never commit
# -----------------------------------------------------------------------------
# Per-machine tool state directory.

.claude/


# -----------------------------------------------------------------------------
# Per-deployment content - never commit (this is client data, not source)
# -----------------------------------------------------------------------------
# Local test posts can live in /posts/ during development but stay out of git.
# Real client content never enters this repo.

/posts/*
!/posts/.gitkeep
!/posts/example.md

/media/*
!/media/.gitkeep
!/media/.htaccess


# -----------------------------------------------------------------------------
# Per-deployment config - never commit (contains password hashes)
# -----------------------------------------------------------------------------
# config.json normally lives outside webroot in production. If a test copy
# ends up in the project for local development, don't let it get committed.

config.json
.config
*.config.json

# rate-limit.json also lives outside webroot in production; defensive ignore
# in case a local-dev copy ends up here.

rate-limit.json

# bootstrap.php contains absolute paths specific to one deployment.
# Commit bootstrap.example.php as a template instead.

bootstrap.php
!bootstrap.example.php

# Per-deployment custom theme. nano.css ships with the project;
# theme-custom.css is per-site branding and stays local.

theme-custom.css
/assets/theme-custom.css
/blog/assets/theme-custom.css


# -----------------------------------------------------------------------------
# Generated files - regenerated by the admin on save, never commit
# -----------------------------------------------------------------------------

sitemap.xml
feed.xml


# -----------------------------------------------------------------------------
# Admin runtime files - defensive ignores; production state lives outside webroot
# -----------------------------------------------------------------------------

/admin/.session
/admin/.log
/admin/sessions/


# -----------------------------------------------------------------------------
# PHP / Composer (in case Composer is ever introduced later)
# -----------------------------------------------------------------------------

/vendor/
composer.lock
composer.phar


# -----------------------------------------------------------------------------
# Logs and debugging output
# -----------------------------------------------------------------------------

*.log
error_log
debug.log


# -----------------------------------------------------------------------------
# Editor and IDE folders
# -----------------------------------------------------------------------------

.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.buildpath
.settings/
nbproject/

# Editor swap and backup files
*.swp
*.swo
*~
*.bak
.#*
\#*#


# -----------------------------------------------------------------------------
# OS-specific junk
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*


# -----------------------------------------------------------------------------
# Archives and packages
# -----------------------------------------------------------------------------

*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z


# -----------------------------------------------------------------------------
# Local environment / secrets
# -----------------------------------------------------------------------------

.env
.env.local
.env.*.local
secrets/
*.key
*.pem
